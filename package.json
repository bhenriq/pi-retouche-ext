{
  "name": "pi-retouche-ext",
  "version": "1.0.0",
  "private": true,
  "description": "Visual, agent-driven editing for HTML and Markdown artifacts (pi extension)",
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "build": "npm run build:client && npm run build:engine",
    "build:client": "esbuild client/main.js --bundle --format=iife --outfile=dist/editor.js",
    "build:engine": "esbuild lib/engine.ts --bundle --format=esm --platform=node --outfile=lib/engine.mjs",
    "test": "node lib/matching.test.cjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "jiti": "^2.7.0"
  }
}
